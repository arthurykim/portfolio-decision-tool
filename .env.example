# Copy this file to .env and fill in real values. .env is gitignored.
#   cp .env.example .env

# Enables Claude-written chat answers and the RAGAS evaluation.
# Without it the assistant still works in extractive mode. Get one at
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Signs session cookies. Generate with: openssl rand -hex 32
# Required in production; a random per-process key is used if unset.
SECRET_KEY=

# Set to 1 when serving over HTTPS so session cookies are Secure-only.
COOKIE_SECURE=

# Seconds before cached price history is refreshed (default 3600).
CACHE_MAX_AGE=
