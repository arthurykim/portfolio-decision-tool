# Copy this file to .env and put real values THERE, never here.
#   cp .env.example .env
# .env is gitignored; THIS file is committed and public — keep every value blank.

# --- AI assistant (optional) -------------------------------------------------
# The chat works with no key at all (extractive mode: returns the best-matching
# knowledge-base passage). A key enables written-prose answers.
# Gemini has a free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: override the Gemini model used for chat.
GEMINI_MODEL=

# --- Web app -----------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -hex 32
# Required in production; a random per-process key is used if unset.
SECRET_KEY=

# Set to 1 when serving over HTTPS so session cookies are Secure-only.
COOKIE_SECURE=

# Seconds before cached price history is refreshed (default 3600).
CACHE_MAX_AGE=

# --- Retrieval ---------------------------------------------------------------
# How the assistant finds passages: bm25 (default, pure Python, no services),
# dense (Milvus only), or hybrid (both, fused by reciprocal rank).
# dense/hybrid need Milvus running and `task vectors:build` to have been run;
# if it is unreachable, retrieval silently falls back to bm25.
RETRIEVAL_MODE=

# Chunking strategy: heading (default), heading_title, paragraph, fixed,
# md_header, md_recursive. Compare them with `task eval:chunking`.
CHUNK_STRATEGY=

# Near-duplicate chunk removal. DEDUP=0 disables it; DEDUP_THRESHOLD is the
# Jaccard cutoff (default 0.9, 1.0 means exact duplicates only).
DEDUP=
DEDUP_THRESHOLD=

# Embedding model (HuggingFace id, runs locally). Default all-MiniLM-L6-v2.
EMBED_MODEL=

# Milvus connection. Default http://localhost:19530.
MILVUS_URI=
MILVUS_COLLECTION=
